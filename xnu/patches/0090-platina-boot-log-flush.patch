+/* One synchronous flush from kernel_bootstrap_thread: capture the
+ * early console even if the periodic thread never gets scheduled. */
 void
+sweet_mmc_log_bootflush(void)
+{
+	uint64_t flushed = 0;
+	int error;
+
+	if (sm.nblocks < 2 * SWEET_MMC_LOG_BLOCKS) {
+		printf("SWEET LOG: boot flush skipped: no partition (nblocks=%llu)\n",
+		    sm.nblocks);
+		return;
+	}
+	printf("SWEET LOG: boot flush begin (block 0x%llx, %llu bytes)\n",
+	    sm.first_block + sm.nblocks - SWEET_MMC_LOG_BLOCKS,
+	    os_atomic_load(&sweet_log_total, relaxed));
+	error = sweet_mmc_log_write(&flushed);
+	if (error) {
+		printf("SWEET LOG: boot flush FAILED (%d)\n", error);
+		return;
+	}
+	printf("SWEET LOG: boot flush done (%llu bytes)\n", flushed);
+}

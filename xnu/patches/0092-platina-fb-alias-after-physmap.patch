diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 6fb6de0..4233973 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1842,7 +1842,12 @@ sweet_early_map_final(void)
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
+	if (*slot != ARM_TTE_EMPTY) {
+		extern void sweet_early_hex(uint64_t);
+		sweet_early_string("SWEET FBMAP slot-not-empty:");
+		sweet_early_hex(*slot);
+		sweet_early_putc('\n');
+	}
 	*slot = 0x9d400000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
@@ -2202,6 +2207,12 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	sweet_early_map_final();
 #endif
 	arm_vm_physmap_init(args);
+#if defined(SWEET)
+	/* Re-assert the fb alias AFTER the physmap pass: boot#22/probe run
+	 * proved physmap_init overwrote our L2 slot (FB ALIAS BROKEN), and
+	 * the console then died on the first post-TTBR0 write. */
+	sweet_early_map_final();
+#endif
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
 	ml_enable_monitor();

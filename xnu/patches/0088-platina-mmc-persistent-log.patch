+/*
+ * Persistent console log ("sweetlog", see 0047). The console hook feeds
+ * sweet_ufs.c's ring; this side flushes it to the LAST 4 MiB + 4 KiB of
+ * the eMMC partition once the root partition is known.
+ */
+#define SWEET_MMC_LOG_BLOCKS    (1u + 0x400000u / MMC_BLOCK)
+
+struct sweet_mmc_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static int sweet_mmc_log_chan;
+
+static void
+sweet_mmc_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = sm.first_block + sm.nblocks - SWEET_MMC_LOG_BLOCKS;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(sm.dma + DMA_BOUNCE);
+
+	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)
+",
+	    SWEET_MMC_LOG_BLOCKS * MMC_BLOCK >> 10, base);
+	for (;;) {
+		(void)tsleep(&sweet_mmc_log_chan, PZERO, "sweetlog", hz);
+		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= sweet_log_ring_size ?
+		    total - sweet_log_ring_size : flushed;
+		int error = 0;
+
+		lck_mtx_lock(&sweet_mmc_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % sweet_log_ring_size);
+			uint32_t blk = off / MMC_BLOCK;
+			uint64_t need = ((uint64_t)off % MMC_BLOCK + (total - pos) + MMC_BLOCK - 1) / MMC_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(sweet_log_ring_size / MMC_BLOCK - blk)),
+			    (uint64_t)(DMA_BOUNCE / MMC_BLOCK));
+			memcpy(bounce, sweet_log_ring + (uint64_t)blk * MMC_BLOCK, n * MMC_BLOCK);
+			error = mmc_write_blocks(base + 1 + blk, n, 0);
+			pos += (uint64_t)(blk + n) * MMC_BLOCK - off;
+		}
+		if (!error) {
+			struct sweet_mmc_log_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = sweet_log_ring_size, .total = total, .seq = ++seq,
+			};
+			bzero(bounce, MMC_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = mmc_write_blocks(base, 1, 0);
+		}
+		lck_mtx_unlock(&sweet_mmc_lock);
+		if (error) {
+			printf("SWEET LOG: write failed (%d), stopping
+", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+sweet_mmc_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || sm.nblocks < 2 * SWEET_MMC_LOG_BLOCKS) {
+		return;
+	}
+	if (kernel_thread_start(sweet_mmc_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}

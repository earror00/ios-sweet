 	return 0;
 }
@@ -812,7 +823,7 @@ sweet_mmc_log_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 }
 
-static void
+void
 sweet_mmc_log_start(void)
 {
 	uint32_t on = 1;
@@ -828,6 +839,30 @@ sweet_mmc_log_start(void)
 }
 
 
+int sweet_mmc_early_done = 0;
+int sweet_mmc_early_phase = 0;
+
+/*
+ * Called from arm_init right after arm_vm_init: bring the eMMC up
+ * while the screen is still on the early console, so that every
+ * later freeze leaves the console log in the eMMC (0088 flush
+ * thread armed by kernel_bootstrap_thread once the scheduler
+ * exists).
+ */
+int
+sweet_mmc_init_early(void)
+{
+	int error;
+	sweet_mmc_early_phase = 1;
+	error = sweet_mmc_init();
+	sweet_mmc_early_phase = 0;
+	if (error == 0) {
+		sweet_mmc_early_done = 1;
+		printf("SWEET MMC: early init complete, log flush armed\n");
+	}
+	return error;
+}
+
 /* Root device for rd=mmcroot0 (IOFindBSDRoot). */
 int sweet_mmc_rootdev(dev_t *dev);
 

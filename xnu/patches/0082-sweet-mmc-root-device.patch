diff --git a/bsd/dev/sweet_mmc.c b/bsd/dev/sweet_mmc.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_mmc.c
@@ -0,0 +1,812 @@
+/*
+ * SWEET internal eMMC root device (read-only).
+ *
+ * platina (SDM660) boots from eMMC; the SDHC1 host (sdhci@c0c4000,
+ * qcom,sdhci-msm-v5) and its clocks are assumed to be left usable by the
+ * bootloader, which started its life reading the abl partition from it.
+ * This driver initializes the card from scratch through the standard SDHCI
+ * command interface: CMD0/CMD1 identify, select, 8-bit bus, high speed, then
+ * one polled SDMA transfer at a time (512 KiB, the largest SDMA boundary)
+ * into a 1 MiB bounce buffer. The host is not cache coherent; caches are
+ * cleaned/invalidated around every transfer. It finds one GPT partition by
+ * name (boot-arg mmcroot=, default "userdata") and exposes it as the BSD
+ * disk mmcroot0 (rmmcroot0), 512-byte logical sectors. Root on it with
+ * rd=mmcroot0.
+ *
+ * Writes are refused (bring-up first, like sweet_ufs was).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* Standard SDHCI register offsets. */
+#define REG_SA          0x00    /* SDMA system address, 32-bit */
+#define REG_BSIZE       0x04    /* block size, 16-bit */
+#define REG_BCOUNT      0x06    /* block count, 16-bit */
+#define REG_ARG         0x08    /* argument, 32-bit */
+#define REG_TMODE       0x0c    /* transfer mode, 16-bit */
+#define REG_CMD         0x0e    /* command, 16-bit */
+#define REG_RESP        0x10    /* response 0..3, 32-bit each */
+#define REG_PS          0x24    /* present state, 32-bit */
+#define REG_HCTRL       0x28    /* host control, 8-bit */
+#define REG_CLKCTRL     0x2c    /* clock control, 16-bit */
+#define REG_TIMEOUT     0x2e    /* timeout control, 8-bit */
+#define REG_RESET       0x2f    /* software reset, 8-bit */
+#define REG_INTSTAT     0x30    /* interrupt status, 32-bit (normal+error) */
+#define REG_INTEN       0x34    /* interrupt enable, 32-bit */
+#define REG_CAP         0x40    /* capabilities, 32-bit */
+#define REG_VER         0xfe    /* host controller version, 16-bit */
+
+#define INT_CMD_DONE    (1u << 0)
+#define INT_XFER_DONE   (1u << 1)
+#define INT_ERR_MASK    0xffff0000u
+
+#define PS_CMD_INH      (1u << 0)
+#define PS_DAT_INH      (1u << 1)
+
+/* Response types (command register bits [9:8]). */
+#define RSP_NONE        0u
+#define RSP_136         1u
+#define RSP_48          2u
+#define RSP_48B         3u
+
+#define MMC_BLOCK       512u
+#define SDMA_CHUNK      (512u << 10)    /* 512 KiB: largest SDMA boundary */
+#define BOUNCE_SIZE     (1u << 20)
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+#define BUSY_TIMEOUT_NS (10ull * NSEC_PER_SEC)
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_BOUNCE      0x0
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the bounce buffer */
+	uint64_t dma_pa;
+	uint32_t base_clock;                    /* Hz, from capabilities */
+	uint32_t rca;
+	bool sector_mode;
+	uint64_t capacity;                      /* device blocks of 512 bytes */
+	uint64_t first_block, nblocks;          /* partition, in 512-byte blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} sm;
+
+static LCK_GRP_DECLARE(sweet_mmc_grp, "sweet_mmc");
+static LCK_MTX_DECLARE(sweet_mmc_lock, &sweet_mmc_grp);
+
+static inline uint32_t
+mmc_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sm.regs + off);
+}
+
+static inline uint16_t
+mmc_rd16(uint32_t off)
+{
+	return *(volatile uint16_t *)(sm.regs + off);
+}
+
+static inline uint8_t
+mmc_rd8(uint32_t off)
+{
+	return *(volatile uint8_t *)(sm.regs + off);
+}
+
+static inline void
+mmc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(sm.regs + off) = v;
+}
+
+static inline void
+mmc_wr16(uint32_t off, uint16_t v)
+{
+	*(volatile uint16_t *)(sm.regs + off) = v;
+}
+
+static inline void
+mmc_wr8(uint32_t off, uint8_t v)
+{
+	*(volatile uint8_t *)(sm.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(sm.dma_pa + off), len, TRUE);
+}
+
+/* Reset one domain and wait for the hardware to clear the bit. */
+static int
+mmc_reset(uint8_t mask, const char *what)
+{
+	mmc_wr8(REG_RESET, mask);
+	for (int i = 0; i < 10000; i++) {
+		if (!(mmc_rd8(REG_RESET) & mask)) {
+			return 0;
+		}
+		delay(10);                      /* spec: <= 100 ms */
+	}
+	printf("SWEET MMC: reset %s timed out (0x%x)\n", what, mask);
+	return ETIMEDOUT;
+}
+
+/*
+ * Program the clock. base_clock comes from the capabilities; the divisor is
+ * base / (2 * f), rounded up, 10 bits.
+ */
+static int
+mmc_set_clock(uint32_t f)
+{
+	uint32_t div = (sm.base_clock + 2 * f - 1) / (2 * f);
+	if (div > 0x3ff) {
+		div = 0x3ff;
+	}
+	uint16_t val = (uint16_t)(((div & 0xff) << 8) | ((div >> 8) << 6));
+	mmc_wr16(REG_CLKCTRL, val);
+	mmc_wr16(REG_CLKCTRL, val | (1u << 0));         /* internal clock on */
+	for (int i = 0; i < 100000; i++) {
+		if (mmc_rd16(REG_CLKCTRL) & (1u << 1)) {        /* stable */
+			mmc_wr16(REG_CLKCTRL, val | (1u << 0) | (1u << 2));
+			return 0;
+		}
+		delay(1);
+	}
+	printf("SWEET MMC: clock %u Hz (div %u) never went stable\n", f, div);
+	return ETIMEDOUT;
+}
+
+/*
+ * One command. data=false: no data phase. data=true: one SDMA transfer of
+ * blocks x 512 bytes at bounce_off (must be <= SDMA_CHUNK total). Response
+ * CRC checking stays off for bring-up robustness. Returns 0 or errno.
+ */
+static int
+mmc_cmd(uint8_t idx, uint32_t arg, unsigned rsp, bool data, bool multi,
+    uint32_t blocks, uint32_t bounce_off, bool read)
+{
+	uint64_t deadline;
+	uint32_t bsize = 0;
+
+	/* Line must be idle; a preceding R1b busy or data phase drains here. */
+	for (int i = 0; i < 100000 && (mmc_rd(REG_PS) & (PS_CMD_INH | PS_DAT_INH)); i++) {
+		delay(10);
+	}
+
+	mmc_wr(REG_INTSTAT, mmc_rd(REG_INTSTAT));       /* clear pending */
+
+	if (data) {
+		bsize = MIN(blocks, SDMA_CHUNK / MMC_BLOCK) * MMC_BLOCK;
+		dma_sync(bounce_off, bsize);
+		mmc_wr(REG_SA, (uint32_t)(sm.dma_pa + bounce_off));
+		mmc_wr16(REG_BSIZE, (uint16_t)(MMC_BLOCK | (7u << 12)));        /* 512K boundary */
+		mmc_wr16(REG_BCOUNT, (uint16_t)blocks);
+		uint16_t tm = (read ? 0 : (1u << 0)) | (1u << 2) |
+		    (multi ? (1u << 1) : 0) | (1u << 4);        /* DMA + block count */
+		mmc_wr16(REG_TMODE, tm);
+	}
+
+	mmc_wr(REG_ARG, arg);
+	/* 16-bit command word: index, data present bit7, response type [9:8]. */
+	uint16_t cmdw = (uint16_t)(idx | (data ? (1u << 7) : 0u) | (rsp << 8));
+	mmc_wr16(REG_CMD, cmdw);
+
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (!(mmc_rd(REG_INTSTAT) & (INT_CMD_DONE | INT_ERR_MASK))) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: CMD%u status timeout (int 0x%x ps 0x%x)\n",
+			    idx, mmc_rd(REG_INTSTAT), mmc_rd(REG_PS));
+			return ETIMEDOUT;
+		}
+	}
+	if (mmc_rd(REG_INTSTAT) & INT_ERR_MASK) {
+		printf("SWEET MMC: CMD%u error arg 0x%x int 0x%x\n",
+		    idx, arg, mmc_rd(REG_INTSTAT));
+		return EIO;
+	}
+
+	if (data) {
+		uint64_t xfer_deadline;
+		nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &xfer_deadline);
+		xfer_deadline += mach_absolute_time();
+		while (!(mmc_rd(REG_INTSTAT) & (INT_XFER_DONE | INT_ERR_MASK))) {
+			if (mach_absolute_time() > xfer_deadline) {
+				printf("SWEET MMC: CMD%u data timeout (int 0x%x ps 0x%x)\n",
+				    idx, mmc_rd(REG_INTSTAT), mmc_rd(REG_PS));
+				return ETIMEDOUT;
+			}
+		}
+		if (mmc_rd(REG_INTSTAT) & INT_ERR_MASK) {
+			printf("SWEET MMC: CMD%u data error int 0x%x\n", idx, mmc_rd(REG_INTSTAT));
+			return EIO;
+		}
+		dma_sync(bounce_off, bsize);
+	}
+	return 0;
+}
+
+static uint32_t
+mmc_resp0(void)
+{
+	return mmc_rd(REG_RESP);
+}
+
+/* R1 card status: READY_FOR_DATA (bit 8) once the busy period is over. */
+static int
+mmc_wait_ready(void)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(BUSY_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		int error = mmc_cmd(13, sm.rca << 16, RSP_48, false, false, 0, 0, false);
+		if (error) {
+			return error;
+		}
+		uint32_t st = mmc_resp0();
+		if ((st & 0x100) && !(st & 0x10000)) {          /* ready, not in error state */
+			return 0;
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: card never went ready (status 0x%x)\n", st);
+			return ETIMEDOUT;
+		}
+		delay(1000);
+	}
+}
+
+/* CMD6 (SWITCH): set EXT_CSD byte to value. R1b busy, then verify via CMD13. */
+static int
+mmc_switch(uint8_t byte, uint8_t value)
+{
+	uint32_t arg = (3u << 24) | ((uint32_t)byte << 16) | ((uint32_t)value << 8);
+	int error = mmc_cmd(6, arg, RSP_48B, false, false, 0, 0, false);
+	if (error) {
+		return error;
+	}
+	return mmc_wait_ready();
+}
+
+/* CMD17/18: read count blocks at lba into the bounce buffer. */
+static int
+mmc_read_blocks(uint64_t lba, uint32_t count, uint32_t bounce_off)
+{
+	bool multi = count > 1;
+	int error = mmc_cmd(multi ? 18 : 17, (uint32_t)lba, RSP_48, true, multi,
+	    count, bounce_off, true);
+	if (!error && multi) {
+		error = mmc_cmd(12, 0, RSP_48B, false, false, 0, 0, false);
+	}
+	return error;
+}
+
+static int
+mmc_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(sm.dma + DMA_BOUNCE);
+	int error = mmc_read_blocks(1, 1, DMA_BOUNCE);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET MMC: no GPT at LBA1 (magic %.8s)\n", (const char *)b);
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET MMC: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = mmc_read_blocks(entry_lba, (nent * esz + MMC_BLOCK - 1) / MMC_BLOCK, DMA_BOUNCE);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		sm.first_block = first;
+		sm.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("SWEET MMC: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+/*
+ * Card bring-up: identify, select, 8-bit bus, high speed.
+ * VCCQ is board wiring (1.8 V on this class of device) and needs no switch
+ * below HS; HS200/1.8 V switching is out of scope for bring-up.
+ */
+static int
+mmc_card_init(void)
+{
+	int error;
+
+	error = mmc_set_clock(400000);
+	if (error) {
+		return error;
+	}
+
+	/* CMD0: go idle. */
+	error = mmc_cmd(0, 0, RSP_NONE, false, false, 0, 0, false);
+	if (error) {
+		return error;
+	}
+
+	/* CMD1: SEND_OP_COND, sector mode + 2.7-3.6 V window. */
+	uint32_t ocr = 0x40ff8000;
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(BUSY_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		error = mmc_cmd(1, ocr, RSP_48, false, false, 0, 0, false);
+		if (error) {
+			return error;
+		}
+		ocr = mmc_resp0();
+		if (ocr & (1u << 31)) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: card never powered up (ocr 0x%x) - "
+			    "flash power or clocks off?\n", ocr);
+			return ETIMEDOUT;
+		}
+		delay(10000);
+	}
+	sm.sector_mode = (ocr & (1u << 30)) != 0;
+	printf("SWEET MMC: card powered up, ocr 0x%x, %s addressing\n",
+	    ocr, sm.sector_mode ? "sector" : "byte");
+
+	/* CMD2/CMD3: CID, then RCA 1. */
+	error = mmc_cmd(2, 0, RSP_136, false, false, 0, 0, false);
+	if (error) {
+		return error;
+	}
+	error = mmc_cmd(3, 1u << 16, RSP_48, false, false, 0, 0, false);
+	if (error) {
+		return error;
+	}
+	sm.rca = 1;
+
+	/* CMD7: select. */
+	error = mmc_cmd(7, sm.rca << 16, RSP_48B, false, false, 0, 0, false);
+	if (error) {
+		return error;
+	}
+	error = mmc_wait_ready();
+	if (error) {
+		return error;
+	}
+
+	/* CMD8: read EXT_CSD for the capacity. */
+	error = mmc_cmd(8, 0, RSP_48, true, false, 1, DMA_BOUNCE, true);
+	if (error) {
+		return error;
+	}
+	const uint8_t *ec = (const uint8_t *)(sm.dma + DMA_BOUNCE);
+	sm.capacity = 0;
+	for (int i = 3; i >= 0; i--) {
+		sm.capacity = (sm.capacity << 8) | ec[212 + i];
+	}
+	printf("SWEET MMC: capacity %llu MiB\n", sm.capacity >> 11);
+
+	/* CMD6: 8-bit bus, then high speed, with matching host settings. */
+	error = mmc_switch(183, 2);             /* BUS_WIDTH = 8-bit */
+	if (error) {
+		return error;
+	}
+	mmc_wr8(REG_HCTRL, 0x20);               /* 8-bit data width (bit5) */
+	error = mmc_switch(185, 1);             /* HS_TIMING */
+	if (error) {
+		return error;
+	}
+	mmc_wr8(REG_HCTRL, 0x20 | 0x4);         /* 8-bit + high speed */
+	return mmc_set_clock(52000000);
+}
+
+static int
+sweet_mmc_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!sm.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+sweet_mmc_close(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_mmc_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * sm.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = sm.nblocks * MMC_BLOCK;
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_mmc_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / MMC_BLOCK;
+		uint32_t skip = (uint32_t)(pos % MMC_BLOCK);
+		uint32_t want = MIN(count - done, SDMA_CHUNK - skip);
+		uint32_t blocks = (skip + want + MMC_BLOCK - 1) / MMC_BLOCK;
+		error = mmc_read_blocks(sm.first_block + lba, blocks, DMA_BOUNCE);
+		if (error) {
+			break;
+		}
+		memcpy(vaddr + done, (const void *)(sm.dma + DMA_BOUNCE + skip), want);
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_mmc_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_mmc_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = sm.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > MMC_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		sm.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = MMC_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = sm.nblocks * MMC_BLOCK / sm.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = SDMA_CHUNK / sm.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_mmc_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_mmc_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_mmc_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_mmc_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_mmc_psize(__unused dev_t dev)
+{
+	return sm.ready ? (int)MIN(sm.nblocks * MMC_BLOCK / sm.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_mmc_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_mmc_strategy, NULL, dev, B_READ, minphys, uio, (int)sm.secsize);
+}
+
+static int
+sweet_mmc_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw sweet_mmc_bdevsw = {
+	.d_open     = sweet_mmc_open,
+	.d_close    = sweet_mmc_close,
+	.d_strategy = sweet_mmc_strategy,
+	.d_ioctl    = sweet_mmc_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_mmc_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_mmc_cdevsw = {
+	.d_open       = sweet_mmc_open,
+	.d_close      = sweet_mmc_close,
+	.d_read       = sweet_mmc_read,
+	.d_write      = sweet_mmc_write,
+	.d_ioctl      = sweet_mmc_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_mmc_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-mmc", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET MMC: no /sweet-mmc node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("mmcroot", want, sizeof(want));
+
+	sm.regs = ml_io_map(reg[0], reg[1]);
+	sm.secsize = DEV_BSIZE;
+
+	/* The host must be usable: capabilities sane, HC alive. */
+	uint32_t cap = mmc_rd(REG_CAP);
+	uint16_t ver = mmc_rd16(REG_VER);
+	sm.base_clock = ((cap >> 8) & 0xff) * 1000000u;
+	if (cap == 0 || cap == 0xffffffff || sm.base_clock == 0) {
+		printf("SWEET MMC: host dead at 0x%lx (ver 0x%x cap 0x%x) - "
+		    "clocks are off, GCC bring-up needed\n", reg[0], ver, cap);
+		return ENXIO;
+	}
+	printf("SWEET MMC: host 0x%lx ver 0x%x cap 0x%x base %u MHz\n",
+	    reg[0], ver, cap, sm.base_clock / 1000000u);
+
+	/* SDMA system address is 32-bit: the bounce buffer must be below 4G. */
+	error = kmem_alloc_contig(kernel_map, &sm.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
+	if (error != KERN_SUCCESS) {
+		printf("SWEET MMC: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)sm.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	sm.dma_pa = ptoa_64(pn);
+	if ((sm.dma_pa + DMA_SIZE - 1) >> 32) {
+		printf("SWEET MMC: DMA at 0x%llx is above 4 GiB, SDMA cannot reach it\n",
+		    sm.dma_pa);
+		return ENXIO;
+	}
+
+	error = mmc_reset(0x4, "all");          /* reset the whole host */
+	if (!error) {
+		mmc_wr8(REG_TIMEOUT, 0xe);
+		mmc_wr(REG_INTEN, 0);           /* polled operation */
+		mmc_wr(REG_INTSTAT, mmc_rd(REG_INTSTAT));
+		error = mmc_card_init();
+	}
+	if (!error) {
+		error = mmc_find_partition(want);
+	}
+	if (error) {
+		return error;
+	}
+
+	sm.bmajor = bdevsw_add(-1, &sweet_mmc_bdevsw);
+	if (sm.bmajor < 0) {
+		return ENXIO;
+	}
+	sm.cmajor = cdevsw_add_with_bdev(-1, &sweet_mmc_cdevsw, sm.bmajor);
+	if (sm.cmajor < 0) {
+		return ENXIO;
+	}
+	sm.bdev = makedev(sm.bmajor, 0);
+	devfs_make_node(sm.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "mmcroot0");
+	devfs_make_node(makedev(sm.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rmmcroot0");
+	sm.ready = true;
+	printf("SWEET MMC: \"%s\": first block 0x%llx, %llu MiB, %s, read-only\n",
+	    want, sm.first_block, sm.nblocks * MMC_BLOCK >> 20,
+	    sm.sector_mode ? "sector mode" : "byte mode");
+	return 0;
+}
+
+/* Root device for rd=mmcroot0 (IOFindBSDRoot). */
+int sweet_mmc_rootdev(dev_t *dev);
+
+int
+sweet_mmc_rootdev(dev_t *dev)
+{
+	if (!sm.ready) {
+		int error = sweet_mmc_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = sm.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */

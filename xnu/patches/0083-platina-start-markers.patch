+	/* PLATINA bring-up markers: paint 5-row color bars at boot_args
+	 * Video.baseAddr + slot*0x6000. One boot shows exactly how far the
+	 * kernel got. x4-x6 are dead at every insertion point here. */
+	ldr	x4, [x20, #0x28]	/* Video.baseAddr */
+	MOV64	x6, 0x6000
+	add	x4, x4, x6
+	MOV64	x5, 0xff00ff00
+	mov	w6, #5400
+Lplatina_m1:
+	str	w5, [x4], #4
+	subs	w6, w6, #1
+	b.ne	Lplatina_m1
+	dsb	sy
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -1,6 +1,16 @@
